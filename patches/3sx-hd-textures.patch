+void ppgRenewLinearDotDataSeqs(Texture* tch, u32 gix, const void* pixels, u32 slot,
+                               u32 side, u32 bpp, u32 density) {
+    if (!tch) tch = ppg_w.cur->tex;
+    if (!tch || !tch->be) return;
+    const s32 ix = gix - tch->ixNum1st;
+    if (ix < 0 || ix >= tch->total || !tch->handle[ix].b16[0]) return;
+    const FLTexture* texture = &flTexture[tch->handle[ix].b16[0] - 1];
+    const unsigned page_density = texture->width / 256;
+    if (texture->width != 256 * page_density || texture->height != texture->width ||
+        !hdAtlasCopy(tch->srcAdrs + tch->srcSize * ix, tch->srcSize,
+                     page_density, slot, side, bpp, pixels, density)) {
+        // Log once: a repeating per-tile message drowns the rest of the output.
+        static bool reported;
+        if (!reported) {
+            reported = true;
+            SDL_Log("HD CG: rejected atlas copy: page %ux%u, slot %u, side %u, bpp %u, source density %u",
+                    texture->width, texture->height, slot, side, bpp, density);
         }
+        return;
     }
+    tch->handle[ix].b16[1] |= 0x2000;
+}
+
+void ppgRenewDotDataSeqs(Texture* tch, u32 gix, u32* srcRam, u32 code, u32 size) {
+    unsigned side, bpp;
+    switch (size) {
+    case 0x40: side = 8; bpp = 1; break;
+    case 0x100: side = 16; bpp = 1; break;
+    case 0x400: side = 32; bpp = 1; break;
+    case 0x80: side = 8; bpp = 2; break;
+    case 0x200: side = 16; bpp = 2; break;
+    case 0x800: side = 32; bpp = 2; break;
+    default: return;
+    }
+    // Stock Morton domain remains 32x32, even when the destination is HD.
+    u8 linear[32 * 32 * 2];
+    for (unsigned y = 0; y < side; y++)
+        for (unsigned x = 0; x < side; x++)
+            SDL_memcpy(linear + (y * side + x) * bpp,
+                       (const u8*)srcRam + dctex_linear[x + y * 32] * bpp, bpp);
+    ppgRenewLinearDotDataSeqs(tch, gix, linear, code, side, bpp, 1);
 }
 
