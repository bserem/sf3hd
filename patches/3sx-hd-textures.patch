diff --git a/src/sf33rd/Source/Game/rendering/hd_atlas.h b/src/sf33rd/Source/Game/rendering/hd_atlas.h
new file mode 100644
index 00000000..140e562d
--- /dev/null
+++ b/src/sf33rd/Source/Game/rendering/hd_atlas.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+// Logical slot class never depends on HD byte count. Source is linear, either
+// stock density or atlas density. All dimensions here are pixels, not bytes.
+static inline bool hdAtlasCopy(void* page, size_t page_bytes, unsigned density,
+                               unsigned slot, unsigned side, unsigned bpp,
+                               const void* pixels, unsigned source_density) {
+    if ((density != 1 && density != 2 && density != 4) ||
+        (source_density != 1 && source_density != density) ||
+        (side != 8 && side != 16 && side != 32) || (bpp != 1 && bpp != 2)) return false;
+    const unsigned columns = side == 32 ? 8 : 16;
+    const unsigned slot_side = side == 32 ? 32 : 16;
+    const unsigned width = 256 * density;
+    if (slot >= columns * columns || page_bytes != (size_t)width * width * bpp) return false;
+    const unsigned x0 = (slot % columns) * slot_side * density;
+    const unsigned y0 = (slot / columns) * slot_side * density;
+    const unsigned source_side = side * source_density;
+    for (unsigned y = 0; y < side * density; y++) {
+        uint8_t* dst = (uint8_t*)page + ((size_t)(y0 + y) * width + x0) * bpp;
+        const uint8_t* src = (const uint8_t*)pixels + (size_t)(y * source_density / density) * source_side * bpp;
+        if (source_density == density) memcpy(dst, src, source_side * bpp);
+        else for (unsigned x = 0; x < side * density; x++)
+            memcpy(dst + x * bpp, src + (x / density) * bpp, bpp);
+    }
+    return true;
+}
diff --git a/src/sf33rd/Source/Game/rendering/hd_cg.c b/src/sf33rd/Source/Game/rendering/hd_cg.c
new file mode 100644
index 00000000..3ee28f0a
--- /dev/null
+++ b/src/sf33rd/Source/Game/rendering/hd_cg.c
@@ -0,0 +1,101 @@
+#include "sf33rd/Source/Game/rendering/hd_cg.h"
+#include "sf33rd/Source/Common/PPGFile.h"
+#include <SDL3/SDL.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define HD_GROUP_MAX 100
+#define HD_PACK_MAX (256 * 1024 * 1024)
+typedef struct { u8* data; unsigned scale, count, group; } HDPack;
+static HDPack packs[HD_GROUP_MAX];
+static bool initialized, any_hd;
+static bool reported[HD_GROUP_MAX];
+static unsigned read32(const u8* p) { return (unsigned)p[0] | ((unsigned)p[1]<<8) | ((unsigned)p[2]<<16) | ((unsigned)p[3]<<24); }
+
+static bool load_one(const char* path, unsigned expected_group) {
+    FILE* f = fopen(path, "rb");
+    if (!f) return false;
+    long length = -1;
+    if (fseek(f, 0, SEEK_END) == 0) length = ftell(f);
+    if (length < 24 || length > HD_PACK_MAX || fseek(f, 0, SEEK_SET) != 0) { fclose(f); return false; }
+    u8* data = SDL_malloc((size_t)length);
+    if (!data) { fclose(f); return false; }
+    bool valid = fread(data, 1, (size_t)length, f) == (size_t)length;
+    fclose(f);
+    if (!valid || SDL_memcmp(data, "3SXCGHD1", 8) != 0) goto invalid;
+    unsigned density = read32(data + 8), group = read32(data + 12), count = read32(data + 16);
+    if ((density != 2 && density != 4) || group != expected_group || group >= HD_GROUP_MAX ||
+        count == 0 || count > 65536 || read32(data + 20) != (unsigned)length || 24 + count*12 > (unsigned)length) goto invalid;
+    unsigned offset = 24 + count*12;
+    for (unsigned i=0; i<count; i++) {
+        const u8* e = data + 24 + i*12;
+        unsigned wh=read32(e), off=read32(e+4), bytes=read32(e+8), side=((wh&3)+1)*8;
+        if (wh > 255 || (side != 8 && side != 16 && side != 32) || off != offset ||
+            bytes != side*side*density*density || off + bytes > (unsigned)length) goto invalid;
+        for (unsigned j=0; j<bytes; j++) if (data[off+j] >= 64) goto invalid;
+        offset += bytes;
+    }
+    if (offset != (unsigned)length) goto invalid;
+    packs[group] = (HDPack){data, density, count, group};
+    any_hd = true;
+    SDL_Log("HD CG: loaded group %u, %u tiles at %ux", group, count, density);
+    return true;
+invalid:
+    SDL_free(data);
+    return false;
+}
+
+static void load_pack(void) {
+    if (initialized) return;
+    initialized = true;
+    const char* path = SDL_getenv("THREESX_HD_CG");
+    if (!path || !*path) return;
+    /* THREESX_HD_CG names a directory of plNN.hdcg sidecars. Archive ids run
+       pl00-pl14 and pl16-pl20 (no pl15); texgroup ids are one higher below 16. */
+    char name[512];
+    for (unsigned group=1; group<=20; group++) {
+        unsigned archive_id = group >= 16 ? group : group - 1;
+        SDL_snprintf(name, sizeof(name), "%s/pl%02u.hdcg", path, archive_id);
+        if (!load_one(name, group)) SDL_Log("HD CG: no valid pack for group %u", group);
+    }
+    /* Player select objects. checkSelObjFileLoaded picks by language:
+       texgrpdat[98] = ef02.bin (Japanese), texgrpdat[23] = ef02_usa.bin. */
+    static const struct { const char* file; unsigned group; } objects[] = {
+        { "ef02.hdcg", 98 }, { "ef02_usa.hdcg", 23 },
+    };
+    for (unsigned i = 0; i < SDL_arraysize(objects); i++) {
+        SDL_snprintf(name, sizeof(name), "%s/%s", path, objects[i].file);
+        load_one(name, objects[i].group);
+    }
+}
+
+/* Caches that carry HD pages: the two player caches, plus cache 13 where the
+   player select objects draw (eff69.c:175). Anything else stays 1x. */
+int hdCgScaleForCache(int id) {
+    load_pack();
+    return (id == 3 || id == 4 || id == 13) && any_hd ? 4 : 1;
+}
+
+void hdCgUpload(MultiTexture* mt, unsigned group, unsigned tile, unsigned wh,
+                unsigned gix, const void* stock, unsigned slot, unsigned size,
+                const u16* palette) {
+    load_pack();
+    const HDPack* hd = group < HD_GROUP_MAX ? &packs[group] : NULL;
+    /* Only the player caches carry HD pages. The same character groups are also
+       uploaded into 1x caches (the opening's mlt_obj_melt2 uses cache 9), and
+       HD pixels do not fit those pages; those uploads stay stock. */
+    if (hd && hd->data && tile < hd->count && hdCgScaleForCache(mt->id) == (int)hd->scale) {
+        const u8* entry = hd->data + 24 + tile*12;
+        if (read32(entry) == wh) {
+            const u8* indices = hd->data + read32(entry+4);
+            unsigned side = ((wh&3)+1)*8;
+            if (!reported[group]) { SDL_Log("HD CG: drawing group %u in cache %d, %ux%u atlas", group, mt->id, 256*hd->scale, 256*hd->scale); reported[group]=true; }
+            if (palette) {
+                u16* rgb = SDL_malloc((size_t)side*side*hd->scale*hd->scale*sizeof(*rgb));
+                if (rgb) { for (unsigned j=0; j<side*side*hd->scale*hd->scale; j++) rgb[j]=palette[indices[j]];
+                    ppgRenewLinearDotDataSeqs(&mt->tex,gix,rgb,slot,side,2,hd->scale); SDL_free(rgb); return; }
+            } else { ppgRenewLinearDotDataSeqs(&mt->tex,gix,indices,slot,side,1,hd->scale); return; }
+        }
+    }
+    ppgRenewDotDataSeqs(&mt->tex, gix, (u32*)stock, slot, size);
+}
